{
  "expo": {
    "name": "TV IA Control",
    "slug": "tv-ia-control",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tviacontrol",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oscarjrdz.tviacontrol",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Control necesita el micrófono para escuchar tus comandos de voz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f0f1a"
      },
      "package": "com.oscarjrdz.tviacontrol",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
